APP_BASE_URL=https://example.vercel.app
SERVICEM8_APP_ID=
SERVICEM8_APP_SECRET=
SERVICEM8_OAUTH_REDIRECT_URI=https://example.vercel.app/api/servicem8/oauth/callback
SERVICEM8_OAUTH_SCOPES=vendor read_jobs read_customers read_job_notes read_staff read_email read_schedule read_attachments read_sms read_job_payments
# Exact ServiceM8 Vendor UUID authorised for this single-account deployment.
SERVICEM8_ALLOWED_ACCOUNT_UUID=
DATABASE_URL=
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# At least 32 random bytes. Generate with: openssl rand -base64 48
SESSION_SIGNING_SECRET=
# Keep disabled until the bounded proof is ready and OpenAI API data controls have been verified.
ASSISTANT_PROOF_ENABLED=false
# Only activates on https://office-agent-staging.vercel.app and requires ASSISTANT_PROOF_ENABLED=true.
STAGING_JOB_SLICE_ENABLED=false
COMPANY_CHECK_ENABLED=false
# Credentials of the separately registered RG Company Check ServiceM8 Add-on.
CC_APP_ID=
CC_APP_SECRET=
NZBN_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_DATA_CONTROLS_VERIFIED=false
